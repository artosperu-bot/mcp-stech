# -----------------------------------------------------------------------------
# SQL Server S-TECH / monitor de distribuidores V8
# -----------------------------------------------------------------------------
# STECH MCP entiende directamente las mismas variables DIST_SQL_* de
# artosperu-bot/scr (rama v8-identity). Puedes copiar esos valores de tu .env
# local existente sin subir secretos al repositorio.
DIST_SQL_SERVER=localhost
DIST_SQL_DATABASE=DB_DISTRIBUIDORES
DIST_SQL_TRUSTED_CONNECTION=yes
DIST_SQL_DRIVER=ODBC Driver 18 for SQL Server
DIST_SQL_ENCRYPT=no
DIST_SQL_USER=
DIST_SQL_PASSWORD=

# Opcional: si deseas separar la configuración del MCP, STECH_SQL_* tiene
# prioridad sobre DIST_SQL_*. Normalmente NO es necesario definirlas.
# STECH_SQL_SERVER=
# STECH_SQL_DATABASE=
# STECH_SQL_DRIVER=
# STECH_SQL_AUTH=windows
# STECH_SQL_USER=
# STECH_SQL_PASSWORD=
# STECH_SQL_ENCRYPT=false
STECH_SQL_TRUST_CERTIFICATE=true

# Contrato de lectura real de scr/v8-identity.
ERP_PRODUCT_VIEW=dbo.V_PRD_PRODUCTO_ACTUAL

# Base separada para evidencias/reglas específicas del MCP/Coolbox.
MCP_SQL_DATABASE=STECH_MCP
MCP_SQL_USER=
MCP_SQL_PASSWORD=

# stdio para validar localmente; streamable-http para Cloudflare.
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8765

# Host público permitido por la protección DNS-rebinding del SDK MCP.
MCP_PUBLIC_HOST=mcp.artos.pe
