# SQL Server del ERP S-TECH
STECH_SQL_DRIVER=ODBC Driver 18 for SQL Server
STECH_SQL_SERVER=PC005
STECH_SQL_DATABASE=DB_ST
# windows | sql
STECH_SQL_AUTH=windows
STECH_SQL_USER=
STECH_SQL_PASSWORD=
STECH_SQL_TRUST_CERTIFICATE=true
STECH_SQL_ENCRYPT=true

# Vista de lectura que el MCP usará para product_get
ERP_PRODUCT_VIEW=dbo.V_MCP_PRODUCTO

# Base propia del MCP (no toca tablas operativas del ERP)
MCP_SQL_DATABASE=STECH_MCP
MCP_SQL_USER=
MCP_SQL_PASSWORD=

# stdio para desarrollo local; streamable-http para URL/túnel
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8765
